# Database URL for PostgreSQL (Supports local PostgreSQL, Neon, Supabase, Railway, etc.)
DATABASE_URL="postgresql://username:password@localhost:5432/theground?schema=public"

# Admin Authentication Secret
ADMIN_SECRET="your-super-secret-key-at-least-32-characters"

# Default Admin Credentials
ADMIN_EMAIL="admin@theground.build"
ADMIN_PASSWORD="change_this_in_production"

# Application Public URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"
