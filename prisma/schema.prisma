datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum ApplicationStatus {
  PENDING
  REVIEWING
  SHORTLISTED
  ACCEPTED
  REJECTED
}

enum InquiryStatus {
  NEW
  REVIEWING
  CONTACTED
  IN_DISCUSSION
  ACCEPTED
  REJECTED
  COMPLETED
}

enum ProjectStage {
  DISCOVERY
  DECISION
  TEAM
  BUILD
  VALIDATE
  SHIP
  MAINTAIN
  LEARN
}

enum ProjectStatus {
  PLANNING
  ACTIVE
  PAUSED
  SHIPPED
  ARCHIVED
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String
  role      String   @default("MEMBER")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Admin {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  role         String   @default("ADMIN")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model StudentApplication {
  id                    String            @id @default(cuid())
  fullName              String
  email                 String            @unique
  phone                 String
  collegeOrOrganization String
  currentStatus         String            // "Student" | "Professional" | "Other"
  courseOrRole          String?           // Course/Degree or Job Role
  yearOrSemester        String?           // Year/Semester or Organization Detail
  status                ApplicationStatus @default(PENDING)
  adminNotes            String?
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt

  @@index([status])
  @@index([email])
}

model ClientInquiry {
  id                    String        @id @default(cuid())
  name                  String
  email                 String
  phone                 String
  companyOrOrganization String
  role                  String
  problem               String
  desiredOutcome        String
  budget                String
  currency              String        @default("INR") // "INR" | "USD"
  timeline              String
  additionalInformation String?
  status                InquiryStatus @default(NEW)
  adminNotes            String?
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt

  @@index([status])
  @@index([email])
}

model Project {
  id          String          @id @default(cuid())
  name        String
  description String
  problem     String
  owner       String
  stage       ProjectStage    @default(DISCOVERY)
  status      ProjectStatus   @default(PLANNING)
  deadline    DateTime?
  progress    Int             @default(0)
  client      String?
  documents   String?         // Stored as JSON or markdown
  blockers    String?
  outcome     String?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  members     ProjectMember[]

  @@index([stage])
  @@index([status])
}

model ProjectMember {
  id        String   @id @default(cuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name      String
  role      String
  email     String
  avatar    String?
  createdAt DateTime @default(now())

  @@index([projectId])
}

model ActivityLog {
  id         String   @id @default(cuid())
  action     String
  details    String
  adminEmail String?
  ipAddress  String?
  createdAt  DateTime @default(now())

  @@index([createdAt])
}
